{
  "name": "arcade",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "portless arcade node scripts/dev.mjs",
    "setup:dev": "bash scripts/setup-dev.sh",
    "dev:tailnet": "portless arcade --tailscale node scripts/dev.mjs",
    "dev:plain": "node scripts/dev.mjs",
    "new": "node scripts/new-game.mjs",
    "build": "vite build",
    "preview": "vite preview --open",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "voices": "node scripts/voices.mjs"
  },
  "dependencies": {
    "@arcade/assets": "workspace:*",
    "@arcade/engine": "workspace:*",
    "@arcade/learning": "workspace:*",
    "@arcade/players": "workspace:*",
    "postprocessing": "^6.39.5",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "portless": "^0.15.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "packageManager": "pnpm@11.3.0"
}
